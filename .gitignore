# Never commit Android release artifacts or signing credentials.
*.aab
*.apk
*.keystore
*.jks
signing-key-info.txt

# Android / Gradle build outputs
.gradle/
build/
local.properties
.kotlin/
captures/

# These archives can contain release artifacts or deployment copies.
*.zip

# Local editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Local landing spots for a signed AAB pulled from the latest-build
# release. play-store/aab/ holds the build awaiting submission; it is
# emptied after the owner submits it for review.
aab/
play-store/aab/
